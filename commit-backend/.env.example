# SQLite by default so you can run this immediately with no setup.
# Swap for a Postgres URL later, matching your other projects:
# DATABASE_URL=postgresql://user:password@localhost:5432/commit_db
DATABASE_URL=sqlite:///./commit.db

# From your Africa's Talking dashboard (account.africastalking.com).
# Use "sandbox" while testing — it's free and doesn't need a registered
# sender id at all. Switch to your real app's username once you've created
# one and registered "commit." under SMS > Alphanumerics.
AT_USERNAME=sandbox
AT_API_KEY=your_sandbox_api_key
AT_SENDER_ID=commit.

# Where the frontend is running — used to build the link in the text.
APP_BASE_URL=http://localhost:5173

# Reminder cap: a recipient gets nudged at most this many times, spaced
# this many hours apart, then reminders stop even if they never respond.
REMINDER_MAX_COUNT=3
REMINDER_INTERVAL_HOURS=48
